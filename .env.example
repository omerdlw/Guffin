# Guffin environment. Copy to `.env` (not `.env.local`): the Next.js app reads
# either, but `npm run db:migrate` only loads `.env`.
#
#   cp .env.example .env
#
# Required = the app will not work without it. Everything else is optional and
# the feature it powers switches off (or falls back) when the value is empty.

# ── Core ─────────────────────────────────────────────────────────────────────

# Required. Postgres connection string. The app and migrations both
# connect as the database owner (RLS is applied by switching roles per request).
# Neon: use the direct (non-pooled) URL. Local: postgres://… on localhost.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/guffin

# Required. Secret Better Auth signs sessions with. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin of the site, no trailing slash. Used as the auth base URL,
# trusted origin and passkey relying party, and for share/OG URLs.
# Defaults to http://localhost:3000 for auth (and https://guffin.film for
# share metadata), so set it in every deployed environment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required for film data. TMDB API "Read Access Token" (v4 bearer token),
# from https://www.themoviedb.org/settings/api.
TMDB_READ_ACCESS_TOKEN=
# Optional override of the TMDB API base URL (e.g. a proxy).
TMDB_API_BASE_URL=

# ── Email (sign-in codes) ────────────────────────────────────────────────────
# Sign-in is email OTP. Resend wins if both are set. With neither set, codes are
# printed to the dev server console in development and sending fails elsewhere.

RESEND_API_KEY=
# Any nodemailer transport URL, e.g. smtp://user:pass@localhost:1025
SMTP_URL=
# Sender address. Defaults to "Guffin <onboarding@resend.dev>".
EMAIL_FROM=

# ── OAuth sign-in (optional) ─────────────────────────────────────────────────
# Each provider turns on only when both its ID and secret are set.
# Callback URL: <NEXT_PUBLIC_SITE_URL>/api/auth/callback/<google|github|twitter>

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# ── Rate limiting (optional) ─────────────────────────────────────────────────
# Upstash Redis for auth and API rate limits. Without it, auth falls back to an
# in-memory limiter (per server instance).

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Scheduled jobs (optional) ────────────────────────────────────────────────
# Bearer token for POST /api/cron/prune (Authorization: Bearer <CRON_SECRET>).
# The route returns 401 for everyone while this is empty.
CRON_SECRET=

# ── Sentry (optional) ────────────────────────────────────────────────────────
# Error reporting is off when the DSN is empty.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only: source map upload. Skipped when the token is empty.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Seed accounts (local development only) ───────────────────────────────────
# Only useful when your database already holds seed accounts (@guffin.test);
# the seed tooling itself is not part of this repo.
# "1" enables POST /api/auth/seed, which signs in as any seeded account without
# a code. Never enable in production.
SEED_LOGIN=
# "1" makes the sign-in surface skip the email code for @guffin.test addresses
# and sign in through the seed route instead (needs SEED_LOGIN).
NEXT_PUBLIC_SEED_LOGIN=
