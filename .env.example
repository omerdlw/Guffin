# Database (Postgres 16, e.g. Neon)
DATABASE_URL=postgres://user:password@host/guffin

# Better Auth
BETTER_AUTH_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OAuth (optional; a provider is enabled when both values are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# TMDB
TMDB_READ_ACCESS_TOKEN=
# TMDB_API_BASE_URL=

# Email: Resend in production, any SMTP server locally
RESEND_API_KEY=
# SMTP_URL=smtp://localhost:1025
EMAIL_FROM=

# Upstash Redis (optional; rate limits fall back to in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Scheduled jobs
CRON_SECRET=

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
