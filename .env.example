# Copy to .env.local and fill in. Only NEXT_PUBLIC_* values reach the browser.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# TMDB v4 read access token (https://www.themoviedb.org/settings/api)
TMDB_READ_ACCESS_TOKEN=
# TMDB_API_BASE_URL=https://api.themoviedb.org/3

# Postgres (Neon in production; local: npm run db:start → postgres://postgres:postgres@127.0.0.1:5433/guffin)
DATABASE_URL=

# Better Auth: 32+ random bytes (openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Outgoing mail for sign-in codes. Production: a Resend sending-only key.
# Local: leave RESEND_API_KEY empty and use Mailpit (smtp://127.0.0.1:1025, inbox http://localhost:8025)
RESEND_API_KEY=
SMTP_URL=
# EMAIL_FROM=Guffin <hello@mail.example.com>   (a sender on a domain verified in Resend)

# OAuth sign-in (optional; a provider shows up only when both values are set)
# Callback URL: <NEXT_PUBLIC_SITE_URL>/api/auth/callback/<google|github|twitter>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Scheduled cleanup: netlify/functions/prune.mts calls POST /api/cron/prune daily with this secret
CRON_SECRET=

# Upstash Redis for rate limiting (optional; limits are skipped without it)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Feature flags
NEXT_PUBLIC_TV_ENABLED=true

# Development only: sign in as a seed account without a code. Never set in production.
# SEED_LOGIN=1
# NEXT_PUBLIC_SEED_LOGIN=1
