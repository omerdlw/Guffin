# Copy to .env.local and fill in. Never commit real values.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TV_ENABLED=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# TMDB
TMDB_READ_ACCESS_TOKEN=
TMDB_API_BASE_URL=

# Upstash Redis (rate limiting; optional locally)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Seed accounts (local development only)
SEED_LOGIN=
NEXT_PUBLIC_SEED_LOGIN=

# Sentry: errors and performance. Off while the DSN is empty.
NEXT_PUBLIC_SENTRY_DSN=
# Source map upload at build time (CI only)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
