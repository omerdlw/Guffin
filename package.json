{
  "name": "guffin",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "node --max-old-space-size=8192 scripts/seed/run.mjs",
    "seed:setup": "node scripts/seed/setup.mjs",
    "seed:env": "node scripts/seed/local-env.mjs",
    "seed:catalog": "node scripts/seed/catalog.mjs",
    "seed:verify": "node scripts/seed/verify.mjs",
    "seed:clean": "node scripts/seed/clean.mjs",
    "seed:probe": "node scripts/seed/probe.mjs",
    "seed:load": "node scripts/seed/load.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@iconify-icon/react": "^3.0.6",
    "@omerdlw/base-framework": "^3.2.2",
    "@sentry/nextjs": "11.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.41.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^13.5.1",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10",
    "eslint-config-next": "^16.4.5",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^3.2.7"
  }
